# Copie ce fichier en .env (cp .env.example .env) puis edite-le.
# Le .env est gitignore, tes secrets ne partiront pas en commit.

# --- Auth UI web Firefox (docker-compose.headless.yml) ---
# Choisis un mot de passe long, c'est l'acces a ton compte Discord.
KASM_USER=admin
KASM_PASS=remplace_par_un_mot_de_passe_long_et_unique

# --- Reglages communs ---
TZ=Europe/Paris
LOG_LEVEL=info

# --- Bind du port UI Firefox ---
# 127.0.0.1 = accessible uniquement via SSH tunnel (recommande).
# 0.0.0.0   = expose sur le LAN / Internet (uniquement si tu as un reverse proxy + auth solide).
FIREFOX_BIND=127.0.0.1
FIREFOX_PORT=3000
